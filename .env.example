# Environment (development, testing, production)
ENVIRONMENT=development

# Database Settings
# For local Docker: postgresql://postgres:postgres@db:5432/bodhrik
# For Supabase: postgresql://postgres.[username]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres (or connection pooler URI)
DATABASE_URL=postgresql://postgres:postgres@db:5432/bodhrik

# Redis Settings
# For local Docker: redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# Security Settings
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=supersecretjwtkeychangeinproduction12345!@#
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
